SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Backend should use the service role for privileged server-side ops.
# Never commit real secrets. Copy this file to backend/.env and fill values.
SUPABASE_SERVICE_ROLE=your-service-role-jwt

# Optional: anon key for read-only use or local debugging
SUPABASE_ANON_KEY=your-anon-jwt
