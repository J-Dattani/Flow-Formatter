{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run backend (uvicorn)",
			"type": "shell",
			"command": "C:/Python313/python.exe",
			"args": [
				"-m",
				"uvicorn",
				"backend.main:app",
				"--host",
				"0.0.0.0",
				"--port",
				"8000",
				"--reload"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		}
	]
}